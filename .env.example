POSTGRES_DB=satellite
POSTGRES_USER=satellite
POSTGRES_PASSWORD=change-me-for-local-use
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
QDRANT_HOST=qdrant
QDRANT_PORT=6333
DATABASE_URL=postgresql://satellite:change-me-for-local-use@postgres:5432/satellite
QDRANT_URL=http://qdrant:6333
QDRANT_API_KEY=
APP_ENV=development
LOG_LEVEL=INFO
API_HOST=0.0.0.0
SERVICE_TIMEOUT_SECONDS=2
STAC_API_URL=https://earth-search.aws.element84.com/v1
STAC_COLLECTION=sentinel-2-l2a
STAC_PROVIDER=Earth Search by Element 84
PROCESSING_RESOLUTION_M=10
PROCESSING_TARGET_CRS=EPSG:32633
AOI_BUFFER_METERS=0
CONTINUOUS_RESAMPLING_METHOD=bilinear
OUTPUT_NODATA=0
RGB_PREVIEW_ENABLED=true
RGB_PREVIEW_PERCENTILE_LOW=2
RGB_PREVIEW_PERCENTILE_HIGH=98
CLOUD_COVERAGE_THRESHOLD=20
CLOUD_PROBABILITY_THRESHOLD=0.4
CLOUD_MODEL=s2cloudless
CLOUD_PROVIDER=sentinel_scl
CLOUD_ALLOW_FALLBACK=false
CLOUD_MASK_REFINEMENT_ENABLED=false
CLOUD_MASK_DILATION_PIXELS=0
CLOUD_MASK_EROSION_PIXELS=0
QUALITY_MASK_VALID_VALUE=0
QUALITY_MASK_CLOUD_VALUE=1
QUALITY_MASK_NODATA_VALUE=2
QUALITY_OUTPUT_NODATA=255
STAC_SEARCH_TIMEOUT_SECONDS=30
DOWNLOAD_TIMEOUT_SECONDS=120
MAX_DOWNLOAD_BYTES=500000000
DATA_DIRECTORY=/app/data
MODEL_DIRECTORY=/app/data/models
SENTINEL_DATA_DIRECTORY=/app/data/raw/sentinel
API_PORT=8000
FRONTEND_PORT=5173
